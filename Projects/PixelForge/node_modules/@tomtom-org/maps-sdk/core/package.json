{
  "name": "core",
  "description": "TomTom Maps SDK JS - bundle for shared core functionalities between map and services",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/core.es.js"
    }
  },
  "sideEffects": false,
  "scripts": {
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:dist": "vitest run dist-validation.test.ts tree-shaking.test.ts",
    "build": "vite build",
    "build:watch": "vite build --watch",
    "build:full": "pnpm type-check && pnpm build",
    "type-check": "tsc --noEmit && tsc -p scripts",
    "clean:dist": "rimraf ./dist",
    "refresh-poi-categories": "node scripts/refreshPoiCategories.ts"
  },
  "peerDependencies": {
    "@turf/turf": "catalog:",
    "lodash-es": "catalog:"
  },
  "devDependencies": {
    "@types/geojson": "catalog:",
    "@types/lodash-es": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "rimraf": "catalog:",
    "shared-configs": "workspace:*",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "typedoc": {
    "entryPoint": "./index.ts"
  }
}
