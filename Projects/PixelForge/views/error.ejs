<% layout("/layouts/boilerplate") -%>

<div class="row justify-content-center my-5">
  <div class="col-12 col-sm-10 col-md-8 col-lg-6">
    <div
      class="alert alert-danger border-0 rounded-4 shadow-sm p-4 text-center"
      role="alert"
    >
      <i class="fa-solid fa-circle-exclamation fa-2x mb-3"></i>

      <h4 class="alert-heading mb-3">Something went wrong</h4>

      <p class="mb-4"><%= message %></p>

      <a href="/listings" class="btn add-btn">
        <i class="fa-solid fa-arrow-left me-2"></i>
        Back to Explore Stays
      </a>
    </div>
  </div>
</div>
