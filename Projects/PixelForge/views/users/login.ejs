
<% layout("/layouts/boilerplate") -%>

<div class="row justify-content-center my-5">
  <div class="col-12 col-sm-10 col-md-7 col-lg-5">
    <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5">

      <div class="text-center mb-4">
        <i class="fa-brands fa-airbnb fa-3x mb-3"></i>
        <h2 class="allgames mb-2">Welcome back</h2>
        <p class="text-muted">
          Log in to continue exploring Aethera.
        </p>
      </div>

      <form
        action="/login"
        method="POST"
        class="needs-validation"
        novalidate
      >
        <div class="mb-3">
          <label for="username" class="form-label">Username</label>
          <input
            name="username"
            id="username"
            type="text"
            class="form-control"
            placeholder="Enter your username"
            autocomplete="username"
            required
          />
          <div class="invalid-feedback">
            Please enter your username.
          </div>
        </div>

        <div class="mb-4">
          <label for="password" class="form-label">Password</label>
          <input
            name="password"
            id="password"
            type="password"
            class="form-control"
            placeholder="Enter your password"
            autocomplete="current-password"
            required
          />
          <div class="invalid-feedback">
            Please enter your password.
          </div>
        </div>

        <button type="submit" class="btn add-btn w-100 py-2">
          Log In
        </button>
      </form>

      <div class="text-center mt-4">
        <span class="text-muted">New to Aethera?</span>
        <a href="/signup" class="text-decoration-none ms-1">
          Create an account
        </a>
      </div>

    </div>
  </div>
</div>
