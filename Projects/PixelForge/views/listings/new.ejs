<% layout('/layouts/boilerplate') -%>
<body>
    <div class="row">
        <div class="col-8 offset-2">
            <br><br>
  <h3>Add a New Game</h3>
  <br>
  <form method="post" action="/listings">
    <div class="mb-3">
      <label for="title" class="form-label">Game Title</label>
      <input
        name="listing[title]"
        placeholder="Enter Game Title"
        type="text"
        class="form-control"
      />
    </div>

    <div class="mb-3">
      <label for="description" class="form-label" >Game Overview</label>
      <textarea
        placeholder="Describe the game, features, and gameplay"
        name="listing[description]"
        type="text"
        class="form-control"
      ></textarea>
    </div>

    <div class="mb-3">
      <label for="image" class="form-label">Cover Art</label>
      <input
        name="listing[image]"
        placeholder="Paste game cover image URL"
        type="text"
        class="form-control"
      />
    </div>

    <div class="row">
        <div class="mb-3 col-md-4">
      <label for="price" class="form-label">Price</label>
      <input
        name="listing[price]"
        placeholder="Enter game price"
        type="number"
        class="form-control"
        />
        </div>

         <div class="mb-3 col-md-8">
      <label for="genre" class="form-label">Game Genre</label>
      <input
        name="listing[genre]"
        placeholder="Enter game genre"
        type="text"
        class="form-control"
      />
        </div>

    </div>

    <div class="mb-3">
      <label for="developer" class="form-label">Development Studio</label>
      <input
        name="listing[developer]"
        placeholder="Enter developer or studio name"
        type="text"
        class="form-control"
      />
    </div>

    <br>
    <button class="btn btn-dark add-btn">Add</button>
    <br>
  </form>
</body>
</div>
</div>
