<% layout('/layouts/boilerplate') -%>
<body>
    <div class="row">
        <div class="col-8 offset-2">
            <br><br>
  <h3>Add a New Game</h3>
  <br>
  <form method="post" action="/listings" novalidate class="needs-validation">
    <div class="mb-3">
      <label for="title" class="form-label">Game Title</label>
      <input
        name="listing[title]"
        placeholder="Enter Game Title"
        type="text"
        class="form-control"
        required
      />
      <div class="valid-feedback">Title looks Good!</div>
       <div class="invalid-feedback">
        Game title is required.
      </div>
    </div>

    <div class="mb-3">
      <label for="description" class="form-label" >Game Overview</label>
      <textarea
        placeholder="Describe the game, features, and gameplay"
        name="listing[description]"
        type="text"
        class="form-control"
        required
      ></textarea>
      <div class="valid-feedback">Overview looks Good!</div>
       <div class="invalid-feedback">
        Please provide a brief description of the game.
      </div>
    </div>

    <div class="mb-3">
      <label for="image" class="form-label">Cover Art</label>
      <input
        name="listing[image]"
        placeholder="Paste game cover image URL"
        type="text"
        class="form-control"
      />
    </div>

    <div class="row">
        <div class="mb-3 col-md-4">
      <label for="price" class="form-label">Price</label>
      <input
        name="listing[price]"
        placeholder="Enter game price"
        type="number"
        class="form-control"
        required
        />
        <div class="valid-feedback">Price looks Good!</div>
         <div class="invalid-feedback">
        Please enter a valid price.
      </div>
        </div>

         <div class="mb-3 col-md-8">
      <label for="genre" class="form-label">Game Genre</label>
      <input
        name="listing[genre]"
        placeholder="Enter game genre"
        type="text"
        class="form-control"
        required
      />
      <div class="valid-feedback">Genre looks Good!</div>
       <div class="invalid-feedback">
        Game genre is required.
      </div>
        </div>

    </div>

    <div class="mb-3">
      <label for="developer" class="form-label">Development Studio</label>
      <input
        name="listing[developer]"
        placeholder="Enter developer or studio name"
        type="text"
        class="form-control"
        required
      />
      <div class="valid-feedback">Studio looks Good!</div>
       <div class="invalid-feedback">
        Development studio is required.
      </div>
    </div>
    <button class="btn btn-dark add-btn">Add</button>
    <br>
     <br>
      <br>
  </form>
</body>
</div>
</div>
