<% layout('/layouts/boilerplate') -%>

<div class="row mt-4">
  <div class="col-6 offset-3 gdt">
    <h2>Game Details</h2>
  </div>
  <div class="col-6 offset-3 mt-3">
    <div class="showcard mx-auto">
      <img
        src="<%= listing.image %>"
        class="card-img-top"
        alt="listing_image"
      />

      <div class="card-body">
        <h5 class="card-title"><b><%= listing.title %></b></h5>
        <br />

        <p class="card-text">
          <i><%= listing.description %></i>
        </p>

        <p class="card-text">
          <b>Price : &#8377;<%= listing.price.toLocaleString("en-IN") %></b> 
        </p>

        <p class="card-text">Developer : <%= listing.developer %></p>

        <p class="card-text"><%= listing.genre %></p>

        <div class="btns">
          <a href="/listings/<%= listing._id %>/edit" class="btn btn-dark edit-btn">
            Edit
          </a>

          <form
            method="post"
            action="/listings/<%= listing._id %>?_method=DELETE"
          >
            <button class="btn btn-dark">Delete</button>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>
```
