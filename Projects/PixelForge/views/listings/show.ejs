
<% layout("/layouts/boilerplate") -%>

<div class="row mt-4 mb-5">
  <!-- Property Details -->
  <div class="col-lg-8 offset-lg-2">
    <div class="mb-3">
      <p class="text-uppercase text-muted small fw-semibold mb-2">
        Discover Aethera
      </p>

      <h2 class="allgames mb-2"><%= listing.title %></h2>

      <p class="text-muted mb-0">
        <i class="fa-solid fa-location-dot me-1"></i>
        <%= listing.location %>, <%= listing.country %>
      </p>
    </div>

    <!-- Property Image and Information -->
    <div class="showcard">
      <img
        src="<%= listing.image %>"
        class="card-img-top"
        alt="<%= listing.title %>"
      />

      <div class="card-body px-0">
        <p class="text-muted mb-3">
          Hosted by
          <strong>
            <%= listing.owner ? listing.owner.username : "Aethera host" %>
          </strong>
        </p>

        <hr />

        <h5>About this stay</h5>

        <div class="listing-description"><%= listing.description %></div>

        <p class="card-text mt-3">
          <strong>
            <%= Number(listing.price).toLocaleString("en-IN", {
              style: "currency",
              currency: "INR",
              maximumFractionDigits: 0
            }) %>
          </strong>
          <span class="text-muted">per night</span>
        </p>

        <!-- Owner Actions -->
        <% if (
          currUser &&
          listing.owner &&
          listing.owner._id.toString() === currUser._id.toString()
        ) { %>
          <div class="btns">
            <a
              href="/listings/<%= listing._id %>/edit"
              class="btn btn-dark edit-btn"
            >
              Edit Property
            </a>

            <form
              method="POST"
              action="/listings/<%= listing._id %>?_method=DELETE"
              onsubmit="return confirm('Are you sure you want to delete this property?');"
            >
              <button type="submit" class="btn btn-outline-danger">
                Delete Property
              </button>
            </form>
          </div>
        <% } %>
      </div>
    </div>
  </div>

  <!-- Reviews Section -->
  <div class="col-lg-8 offset-lg-2 mt-4">
    <hr />

    <!-- Add Review Form -->
    <% if (currUser) { %>
      <h4>Share Your Experience</h4>

      <p class="text-muted">
        How was your stay or what do you think of this property?
      </p>

      <form
        action="/listings/<%= listing._id %>/reviews"
        method="POST"
        novalidate
        class="needs-validation"
      >
        <!-- Star Rating -->
        <div class="mb-3">
          <fieldset class="starability-slot">
            <legend class="form-label">Your rating</legend>

            <input
              type="radio"
              id="no-rate"
              class="input-no-rate"
              name="review[rating]"
              value="1"
              checked
              aria-label="1 star"
              required
            />

            <input
              type="radio"
              id="first-rate1"
              name="review[rating]"
              value="1"
            />
            <label for="first-rate1" title="Terrible">1 star</label>

            <input
              type="radio"
              id="first-rate2"
              name="review[rating]"
              value="2"
            />
            <label for="first-rate2" title="Not good">2 stars</label>

            <input
              type="radio"
              id="first-rate3"
              name="review[rating]"
              value="3"
            />
            <label for="first-rate3" title="Average">3 stars</label>

            <input
              type="radio"
              id="first-rate4"
              name="review[rating]"
              value="4"
            />
            <label for="first-rate4" title="Very good">4 stars</label>

            <input
              type="radio"
              id="first-rate5"
              name="review[rating]"
              value="5"
            />
            <label for="first-rate5" title="Amazing">5 stars</label>
          </fieldset>
        </div>

        <!-- Review Comment -->
        <div class="mb-3">
          <label for="comment" class="form-label">Your Review</label>

          <textarea
            name="review[comment]"
            id="comment"
            rows="4"
            class="form-control"
            placeholder="Share what you liked about this property..."
            required
          ></textarea>

          <div class="invalid-feedback">
            Please write a review before submitting.
          </div>
        </div>

        <button type="submit" class="btn btn-dark add-btn">
          Submit Review
        </button>
      </form>
    <% } else { %>
      <p>
        <a href="/login">Log in</a> to share your experience.
      </p>
    <% } %>

    <hr class="my-4" />

    <!-- Guest Reviews -->
    <h4 class="mb-3">Guest Reviews</h4>

    <% if (listing.reviews && listing.reviews.length > 0) { %>
      <div class="row g-3">
        <% for (const review of listing.reviews) { %>
          <div class="col-md-6">
            <div class="review-card h-100">

              <!-- Reviewer Information -->
              <div class="review-author">
                <span class="review-username">
                  @<%= review.author ? review.author.username : "Guest" %>
                </span>
              </div>

              <!-- Star Rating -->
              <p
                class="starability-result"
                data-rating="<%= review.rating %>"
                aria-label="<%= review.rating %> out of 5 stars"
              >
                Rated <%= review.rating %> out of 5 stars
              </p>

              <!-- Review Comment -->
              <p class="review-comment"><%= review.comment %></p>

              <!-- Review Date -->
              <% if (review.createdAt) { %>
                <small class="text-muted">
                  <%= new Date(review.createdAt).toLocaleDateString("en-IN", {
                    day: "numeric",
                    month: "short",
                    year: "numeric"
                  }) %>
                </small>
              <% } %>

              <!-- Delete Own Review -->
              <% if (
                currUser &&
                review.author &&
                review.author._id.toString() === currUser._id.toString()
              ) { %>
                <form
                  method="POST"
                  action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE"
                  onsubmit="return confirm('Are you sure you want to delete this review?');"
                >
                  <button type="submit" class="delete-review-btn">
                    Delete Review
                  </button>
                </form>
              <% } %>

            </div>
          </div>
        <% } %>
      </div>
    <% } else { %>
      <p class="text-muted">
        No reviews yet. Be the first to share your experience.
      </p>
    <% } %>

    <hr class="my-4" />

    <!-- TomTom Property Location Map -->
    <section class="listing-map-section mt-2 mb-4">
      <h4 class="mb-2">Where you'll be</h4>

      <p class="text-muted mb-3">
        Explore the location of this stay.
      </p>

      <% if (
        listing.geometry &&
        listing.geometry.type === "Point" &&
        listing.geometry.coordinates &&
        listing.geometry.coordinates.length === 2
      ) { %>
        <div
          id="listing-map"
          data-longitude="<%= listing.geometry.coordinates[0] %>"
          data-latitude="<%= listing.geometry.coordinates[1] %>"
          aria-label="Interactive map showing the property location"
        ></div>

        <p
          id="listing-map-status"
          class="text-muted small mt-2"
          role="status"
        ></p>
      <% } else { %>
        <div class="alert alert-light border" role="status">
          <i class="fa-solid fa-location-dot me-2"></i>
          Map location is not available for this property yet.
        </div>
      <% } %>
    </section>
  </div>
</div>

<!-- TomTom map assets -->
<link rel="stylesheet" href="/build/tomtom-map.css" />
<script type="module" src="/build/tomtom-map.js"></script>
