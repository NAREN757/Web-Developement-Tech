<% layout('/layouts/boilerplate') -%>
<br>
<h3>All Games</h3>
<br>

<div class="row row-cols-lg-5 row-cols-md-3 row-cols-sm-1 g-5">

  <% for(let listing of allListings) { %>

    <div class="col">
      <a href="/listings/<%= listing._id %>" class="listing-link">

        <div class="card">

          <img
            src="<%= listing.image %>"
            class="card-img-top"
            alt="Listings_image"
            style="height: 16rem"
          >

          <div class="card-img-overlay"></div>

          <div class="card-body">

            <h5 class="card-title">
              <b><%= listing.title %></b>
            </h5>

            <p class="card-text">
              Rs <%= listing.price.toLocaleString("en-IN") %>
            </p>

          </div>

        </div>

      </a>
    </div>

  <% } %>

</div>