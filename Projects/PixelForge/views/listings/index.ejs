<% layout('/layouts/boilerplate') -%>

<br>

<h3 class="allgames">All games</h3>

<br>

<p class="text-muted fs-6">
  Showing
  <%= allListings.length %>
  of
  <%= totalListings %>
  results.
</p>

<br>


<!-- Games -->

<div class="row row-cols-lg-5 row-cols-md-3 row-cols-sm-1 g-5">

  <% for(let listing of allListings) { %>

    <div class="col">

      <a
        href="/listings/<%= listing._id %>"
        class="listing-link"
      >

        <div class="card">

          <img
            src="<%= listing.image %>"
            class="card-img-top"
            alt="Listings_image"
            style="height: 16rem"
          >

          <div class="card-img-overlay"></div>

          <div class="card-body">

            <h5 class="card-title">
              <b><%= listing.title %></b>
            </h5>

            <p class="card-text">
              Rs <%= listing.price.toLocaleString("en-IN") %>
            </p>

          </div>

        </div>

      </a>

    </div>

  <% } %>

</div>


<br>
<br>


<!-- Pagination -->
<% if (totalPages > 1) { %>
  <nav aria-label="Game pages">
    <ul class="pagination justify-content-center">
      <!-- Previous -->
      <% if (currentPage > 1) { %>
        <li class="page-item">
          <a
            class="page-link"
            href="/listings?page=<%= currentPage - 1 %>"
          >
            Previous
          </a>
        </li>
      <% } else { %>
        <li class="page-item disabled">
          <span class="page-link">
            Previous
          </span>
        </li>
      <% } %>

      <!-- Page Numbers -->
      <% for(let i = 1; i <= totalPages; i++) { %>
        <li
          class="page-item <%= currentPage === i ? 'active' : '' %>"
        >
          <a
            class="page-link"
            href="/listings?page=<%= i %>"
          >
            <%= i %>
          </a>
        </li>
      <% } %>

      <!-- Next -->
      <% if (currentPage < totalPages) { %>
        <li class="page-item">
          <a
            class="page-link"
            href="/listings?page=<%= currentPage + 1 %>"
          >
            Next
          </a>
        </li>
      <% } else { %>
        <li class="page-item disabled">
          <span class="page-link">
            Next
          </span>
        </li>
      <% } %>
    </ul>
  </nav>
<% } %>
<br>